@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/dacoexecTargets.cmake")

foreach(component IN LISTS dacoexec_FIND_COMPONENTS)
  set(dacoexec_${component}_FOUND FALSE)
  if(component STREQUAL "execution" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/dacoexecExecutionTargets.cmake")
    include(CMakeFindDependencyMacro)
    find_dependency(stdexec CONFIG REQUIRED)
    include("${CMAKE_CURRENT_LIST_DIR}/dacoexecExecutionTargets.cmake")
    set(dacoexec_execution_FOUND TRUE)
  endif()
endforeach()

check_required_components(dacoexec)
